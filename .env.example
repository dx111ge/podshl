# The operator's identity, for the imprint every public service here owes.
#
# Copy to `.env`, which is gitignored. This is a real legal identity and it does
# not belong in a repository that is destined to be published — `PUBLISHING.md`
# is already firm that no internal address goes into the published tree, and an
# operator's home address is exactly that kind of thing.
#
# Note what SERVER.md says about the shape of this, because it is a decision and
# not a formality: operating personally means unlimited liability against private
# assets and a **home address in the Impressum**. A limited company — a UG is the
# small form, one euro of capital — caps the liability and puts the company's
# address on the site instead. That is an operating decision, not an
# architectural one, but it is the address a letter arrives at.

PODSHL_IMPRINT_NAME=
PODSHL_IMPRINT_ADDRESS=
PODSHL_IMPRINT_EMAIL=

# Optional, and only if the operator is a registered company.
PODSHL_IMPRINT_REGISTER=

# Where to report a security finding, and when that contact stops being valid.
# `/.well-known/security.txt` is served only when both are set, because RFC 9116
# requires the expiry and a contact nobody answers is worse than none.
PODSHL_SECURITY_CONTACT=
PODSHL_SECURITY_EXPIRES=

# Where a notice-and-action complaint reaches a person.
PODSHL_NOTICE_CONTACT=

# Where this project's own source lives. The client is what reads somebody's
# machine, so it has to be inspectable by the people it reads — but a page
# claiming to be open source with a link that 404s is worse than one that says
# the repository is not up yet.
PODSHL_SOURCE_URL=


# ---------------------------------------------------------------- the client
#
# Read by the client binary, not by the server. Both default to the loopback
# addresses a development checkout uses, so leaving them unset changes nothing.
#
# They exist because a released binary with these compiled in could only ever
# talk to the machine it was running on. Set them on a packaged build to point
# it at a real host. They are read once, at start, in Rust — deliberately not a
# setting the window can write, because an operator endpoint a page could change
# is one a page could redirect, and this client sends a report there.

PODSHL_SERVER_URL=
PODSHL_INDEX_URL=


# ------------------------------------------------------------ the operator view
#
# The bearer token every route on the operator's own listener (:8726) requires.
# Loopback is a wall, not a person: anything on the same host reaches a
# loopback port, so the listener also wants to be told who is asking. Unset,
# it answers 503 to everything. The development container mints one per start
# when this is empty and writes it to var/ops.token; on a real host it goes in
# the ops unit's own environment file and nowhere else.
PODSHL_OPS_TOKEN=

# Extra `Host` values the operator listener answers to, comma-separated. It
# always accepts 127.0.0.1:8726 and localhost:8726; a name resolving to
# loopback is the shape a browser-based attack on it takes, so anything else
# has to be listed here on purpose.
PODSHL_OPS_HOSTS=

# Whether a missing log signing key may be minted on first use. Only the
# development container sets this. A production host that starts without its
# key must refuse to sign rather than fork the log under a key nobody pinned.
PODSHL_LOG_KEY_CREATE=
