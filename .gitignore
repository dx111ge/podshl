# environment (6.8 GB) and model cache (multi-GB) — never commit
.venv/
.hf/

# data & artefacts — local only, never on the remote.
# The corpus is fetched with `mise run fetch-corpus`; nothing here is source.
data/
out/
*.gguf
*.safetensors
*.bin

# tooling
wandb/
runs/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.mise.local.toml

# runtime state: keys, live config, server logs
var/

# The monitor's own state. `spec/monitor/verify_log.py` writes the last root it
# saw beside itself unless told otherwise, and that file is one watcher's
# observation of one log — not something a checkout should carry.
podshl-monitor.json

# rust build artefacts
client-rs/target/

# generated by tauri at build time
client-rs/gen/

# The operator's own identity. A real name and a postal address, which do not
# belong in a repository that is meant to be published. `.env.example` is the
# shape; `.env` is yours.
.env
# The operator view's bearer token, kept apart from .env on a host.
ops.env
# What deploy/compose/backup.sh writes: the log's signing key and the database.
deploy/compose/backups/

# A path MSYS invented. Passing `-e CARGO_TARGET_DIR=/cargo-target-uitest` from
# a Windows shell handed the container `C:/Program Files/Git/...`, cargo made
# the directory, and three build artefacts were committed before anybody
# noticed. The cause is fixed in `scripts/ci.sh`; this is so the symptom cannot
# come back quietly.
client-rs/C[:]*/
