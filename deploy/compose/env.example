# Copy to `.env` beside compose.yaml on the host. Never committed.

# ---------------------------------------------------------------- the machine

# The database password. Long and random; nothing outside the `inside` network
# can reach the database, and this is what stands between the containers on it.
#   openssl rand -base64 33
POSTGRES_PASSWORD=

# The address Caddy serves. A domain name (podshl.example.org) gets a Let's
# Encrypt certificate on first start, once its DNS A record points here. Empty,
# `:80`: plain HTTP on the bare IP, for checking a fresh machine — not public.
PODSHL_SITE=

# ---------------------------------------------------------------- the imprint
#
# The operator's legal identity, served at /imprint. Unset, /imprint answers
# 503 and says what is missing. Operating personally puts a home address here
# and means unlimited liability — SERVER.md, "Hosting abroad moves nothing".

PODSHL_IMPRINT_NAME=
PODSHL_IMPRINT_ADDRESS=
PODSHL_IMPRINT_EMAIL=
PODSHL_IMPRINT_REGISTER=

# security.txt is served only when both are set (RFC 9116 requires the expiry).
PODSHL_SECURITY_CONTACT=
PODSHL_SECURITY_EXPIRES=

PODSHL_NOTICE_CONTACT=
PODSHL_SOURCE_URL=
